+#define USB_CONNECT_PIN              GPIO_PIN_12
+/* CNF=01 MODE=00 → floating input (USB peripheral / hard 1k5 take over) */
+#define USB_CONNECT_ON()             do {         GPIOA->CRH = (GPIOA->CRH & ~(0xFul << 16)) | (0x4ul << 16);     } while (0)
+/* CNF=00 MODE=10 → GP push-pull 2 MHz output, drive DP low */
+#define USB_CONNECT_OFF()            do {         GPIOA->BRR = (1u << 12);         GPIOA->CRH = (GPIOA->CRH & ~(0xFul << 16)) | (0x2ul << 16);         GPIOA->BRR = (1u << 12);     } while (0)
