-
+#define nRESET_PIN                   GPIO_PIN_8
+#define nRESET_PIN_Bit               8
+
+/* SWD to target — Blue Pill own SWD header (PA13/PA14)
+ * SWDIO_OUT and SWDIO_IN share PA13 (bidirectional single-wire).
+ * Requires AFIO SWJ fully disabled before driving these as GPIO. */
